{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citizenship-test.app/schemas/questions.schema.json",
  "title": "Australian Citizenship Test Question Bank",
  "description": "Schema for a versioned, reviewed, offline question bank.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "questionBankVersion",
    "generatedAt",
    "sourceEditions",
    "categories",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Version of this JSON document structure."
    },
    "questionBankVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC date and time when the question bank was generated."
    },
    "minimumAppVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "language": {
      "type": "string",
      "const": "en-AU",
      "default": "en-AU"
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyrightNotice",
        "licenceName",
        "licenceUrl",
        "disclaimer"
      ],
      "properties": {
        "copyrightNotice": {
          "type": "string",
          "minLength": 1
        },
        "licenceName": {
          "type": "string",
          "const": "Creative Commons Attribution 4.0 International"
        },
        "licenceUrl": {
          "type": "string",
          "format": "uri",
          "const": "https://creativecommons.org/licenses/by/4.0/"
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceEditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceEdition"
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "removedQuestions": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/removedQuestion"
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "examples": [
        "1.0.0",
        "1.2.0",
        "2.0.0-beta.1"
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 100,
      "description": "Stable lowercase identifier using letters, numbers and hyphens."
    },
    "sourceEdition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "publisher",
        "edition",
        "publicationYear",
        "url",
        "licence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1,
          "description": "Edition label or document version used during review."
        },
        "publicationYear": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "retrievedAt": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "licence": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Optional SHA-256 checksum of the reviewed source document."
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "displayOrder",
        "isActive"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "displayOrder": {
          "type": "integer",
          "minimum": 0
        },
        "isActive": {
          "type": "boolean"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "status",
        "text",
        "categoryId",
        "difficulty",
        "isAustralianValuesQuestion",
        "options",
        "sourceReferences",
        "review",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier",
          "description": "Stable question ID. Do not reuse it for a materially different question."
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Incremented for non-material corrections to this question."
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "ready_for_review",
            "approved",
            "needs_changes",
            "archived"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "categoryId": {
          "$ref": "#/$defs/identifier"
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "isAustralianValuesQuestion": {
          "type": "boolean",
          "description": "Identifies questions subject to any special Australian-values exam rule."
        },
        "overallExplanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/questionOption"
          }
        },
        "sourceReferences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        },
        "tags": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "archivedAt": {
          "type": "string",
          "format": "date-time"
        },
        "archiveReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "replacementQuestionId": {
          "$ref": "#/$defs/identifier"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "review": {
                "$ref": "#/$defs/approvedReview"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "archived"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "archivedAt",
              "archiveReason"
            ]
          }
        }
      ]
    },
    "questionOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "isCorrect",
        "explanation",
        "displayOrder"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier",
          "description": "Stable option ID unique within its question."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "isCorrect": {
          "type": "boolean"
        },
        "explanation": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000,
          "description": "Explains why this option is correct or incorrect."
        },
        "displayOrder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceEditionId",
        "part",
        "section",
        "pageStart",
        "pageEnd"
      ],
      "properties": {
        "sourceEditionId": {
          "$ref": "#/$defs/identifier"
        },
        "part": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "chapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "section": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "pageStart": {
          "type": "integer",
          "minimum": 1
        },
        "pageEnd": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_reviewed",
            "in_review",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceVerified": {
          "type": "boolean"
        },
        "wordingVerified": {
          "type": "boolean"
        },
        "correctAnswerVerified": {
          "type": "boolean"
        },
        "optionExplanationsVerified": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 3000
        }
      }
    },
    "approvedReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "reviewedAt",
        "sourceVerified",
        "wordingVerified",
        "correctAnswerVerified",
        "optionExplanationsVerified"
      ],
      "properties": {
        "status": {
          "const": "approved"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceVerified": {
          "const": true
        },
        "wordingVerified": {
          "const": true
        },
        "correctAnswerVerified": {
          "const": true
        },
        "optionExplanationsVerified": {
          "const": true
        },
        "notes": {
          "type": "string",
          "maxLength": 3000
        }
      }
    },
    "removedQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId",
        "removedAt",
        "reason"
      ],
      "properties": {
        "questionId": {
          "$ref": "#/$defs/identifier"
        },
        "removedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "enum": [
            "source_changed",
            "fact_changed",
            "incorrect_content",
            "duplicate",
            "replaced",
            "other"
          ]
        },
        "replacementQuestionId": {
          "$ref": "#/$defs/identifier"
        },
        "userMessage": {
          "type": "string",
          "default": "This question is no longer available because the question bank was updated.",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}